# Where the Amarathon backend lives. Production defaults to this value; leave
# it unset in local development so Vite proxies /api to VITE_DEV_API instead.
VITE_API_BASE_URL=https://amarathon.krishnarajthadesar.in
VITE_API_GATEWAY_URL=https://api-get-away.krishnarajthadesar.in
VITE_GATEWAY_ROUTE=/api/amarathon

# Backend the dev server proxies to. Only used by `npm run dev`.
VITE_DEV_API=http://localhost:8010
